<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LRTK Report — {{ stats.name }}</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg: #0f172a;
      --panel: #1e293b;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --success: #22c55e;
      --failure: #f97316;
      --refusal: #eab308;
      --unknown: #64748b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
    }
    header {
      padding: 2rem 2.5rem;
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border-bottom: 3px solid var(--accent);
    }
    header h1 { margin: 0 0 .25rem; font-size: 1.6rem; }
    header .run-id { color: var(--muted); font-family: ui-monospace, monospace; }
    main { max-width: 1100px; margin: 0 auto; padding: 2rem 2.5rem 4rem; }
    .banner {
      border-left: 4px solid var(--danger);
      background: rgba(239, 68, 68, .12);
      padding: .75rem 1rem;
      border-radius: 6px;
      margin-bottom: 1.5rem;
      font-size: .92rem;
    }
    h2 { border-bottom: 1px solid #334155; padding-bottom: .35rem; margin-top: 2rem; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
    .card {
      background: var(--panel);
      border-radius: 10px;
      padding: 1rem 1.2rem;
      border: 1px solid #334155;
    }
    .card .label { color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; }
    .card .value { font-size: 1.7rem; font-weight: 700; margin-top: .2rem; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 800px) { .grid-2 { grid-template-columns: 1fr; } }
    .panel { background: var(--panel); border: 1px solid #334155; border-radius: 10px; padding: 1rem 1.25rem; }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    th, td { text-align: left; padding: .45rem .6rem; border-bottom: 1px solid #334155; vertical-align: top; }
    th { color: var(--muted); font-weight: 600; }
    .badge { display: inline-block; padding: .1rem .55rem; border-radius: 999px; font-size: .78rem; font-weight: 600; }
    .badge.success { background: rgba(34, 197, 94, .18); color: var(--success); }
    .badge.failure { background: rgba(249, 115, 22, .18); color: var(--failure); }
    .badge.refusal { background: rgba(234, 179, 8, .18); color: var(--refusal); }
    .badge.unknown { background: rgba(100, 116, 139, .25); color: var(--muted); }
    details { background: var(--panel); border: 1px solid #334155; border-radius: 8px; margin: .6rem 0; padding: .5rem 1rem; }
    details summary { cursor: pointer; font-weight: 600; }
    pre {
      background: #0b1220;
      border: 1px solid #334155;
      border-radius: 6px;
      padding: .8rem 1rem;
      overflow-x: auto;
      font-size: .82rem;
      white-space: pre-wrap;
      word-break: break-word;
    }
    code { font-family: ui-monospace, "Cascadia Code", monospace; }
    .muted { color: var(--muted); }
    .error { color: var(--danger); }
  </style>
</head>
<body>
  <header>
    <h1>LRTK Engagement Report — {{ stats.name }}</h1>
    <div class="run-id">{{ stats.run_id }} · status: {{ stats.status }}</div>
  </header>
  <main>
    <div class="banner">
      <strong>Authorized testing only.</strong>
      This artifact was generated by LLM Red Team Kit for a security
      assessment conducted under explicit written authorization. Owner:
      <code>{{ stats.authorization.owner if stats.authorization else 'not recorded' }}</code>
      · Scope:
      <code>{{ stats.authorization.scope if stats.authorization else 'not recorded' }}</code>
    </div>

    <section class="cards">
      <div class="card"><div class="label">Total turns</div><div class="value">{{ stats.total }}</div></div>
      <div class="card"><div class="label">Success rate</div><div class="value">{{ '%.1f' | format(stats.success_rate * 100) }}%</div></div>
      <div class="card"><div class="label">Successes</div><div class="value" style="color:var(--success)">{{ stats.successes }}</div></div>
      <div class="card"><div class="label">Failures</div><div class="value" style="color:var(--failure)">{{ stats.failures }}</div></div>
      <div class="card"><div class="label">Refusals</div><div class="value" style="color:var(--refusal)">{{ stats.refusals }}</div></div>
      <div class="card"><div class="label">Unknown</div><div class="value" style="color:var(--muted)">{{ stats.unknowns }}</div></div>
      <div class="card"><div class="label">Errors</div><div class="value" style="color:var(--danger)">{{ stats.errors }}</div></div>
      <div class="card"><div class="label">Avg. score</div><div class="value">{{ stats.avg_score }}</div></div>
    </section>

    <h2>Score distribution</h2>
    <div class="grid-2">
      <div class="panel">
        <canvas id="pieChart" height="220" aria-label="Outcome pie chart"></canvas>
        <noscript>
          <table>
            <tr><th>Outcome</th><th>Count</th></tr>
            <tr><td>success</td><td>{{ stats.successes }}</td></tr>
            <tr><td>failure</td><td>{{ stats.failures }}</td></tr>
            <tr><td>refusal</td><td>{{ stats.refusals }}</td></tr>
            <tr><td>unknown</td><td>{{ stats.unknowns }}</td></tr>
          </table>
        </noscript>
      </div>
      <div class="panel">
        <h3 style="margin-top:0">Engagement metadata</h3>
        <table>
          <tr><th>Started</th><td>{{ stats.started_at }}</td></tr>
          <tr><th>Finished</th><td>{{ stats.finished_at or '—' }}</td></tr>
          <tr><th>Duration (ms)</th><td>{{ stats.duration_ms }}</td></tr>
          <tr><th>Scorers</th><td>{{ stats.scorers | join(', ') or 'none' }}</td></tr>
          <tr><th>Converters</th><td>{{ stats.converter_chain | join(' → ') or 'none' }}</td></tr>
        </table>
      </div>
    </div>

    <h2>Cases ({{ stats.total }})</h2>
    {% for row in stats.rows %}
    <details>
      <summary>
        #{{ row.index }} · {{ row.prompt_id }} ·
        <span class="badge {{ row.label }}">{{ row.label }}</span>
        · score {{ '%.2f' | format(row.value) }}
        {% if row.error %}<span class="error">· target error</span>{% endif %}
      </summary>
      <p class="muted">Original prompt</p>
      <pre>{{ row.prompt_text }}</pre>
      <p class="muted">Prompt actually sent (after converters)</p>
      <pre>{{ row.sent_text }}</pre>
      <p class="muted">Target response ({{ row.target }}, {{ row.latency_ms }} ms)</p>
      {% if row.error %}
      <pre class="error">{{ row.error }}</pre>
      {% else %}
      <pre>{{ row.response_text }}</pre>
      {% endif %}
      <p class="muted">Scores</p>
      <table>
        <tr><th>Scorer</th><th>Label</th><th>Value</th><th>Rationale</th></tr>
        {% for score in row.scores %}
        <tr>
          <td>{{ score.scorer }}</td>
          <td><span class="badge {{ score.label }}">{{ score.label }}</span></td>
          <td>{{ '%.2f' | format(score.value) }}</td>
          <td>{{ score.rationale or '' }}</td>
        </tr>
        {% endfor %}
      </table>
    </details>
    {% endfor %}

    <h2>Reproducible configuration</h2>
    <details>
      <summary>Resolved configuration snapshot</summary>
      <pre>{{ stats.config | tojson(indent=2) }}</pre>
    </details>
  </main>

  <script>
    (function () {
      if (typeof Chart === "undefined") { return; }
      var counts = {
        success: {{ stats.successes | tojson }},
        failure: {{ stats.failures | tojson }},
        refusal: {{ stats.refusals | tojson }},
        unknown: {{ stats.unknowns | tojson }}
      };
      new Chart(document.getElementById("pieChart"), {
        type: "pie",
        data: {
          labels: ["success", "failure", "refusal", "unknown"],
          datasets: [{
            data: [counts.success, counts.failure, counts.refusal, counts.unknown],
            backgroundColor: ["#22c55e", "#f97316", "#eab308", "#64748b"]
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { labels: { color: "#e2e8f0" } }
          }
        }
      });
    })();
  </script>
</body>
</html>
