# LRTK environment configuration example.
#
# Copy this file to `.env` and fill in values yourself.
# LRTK only ever reads credentials from environment variables;
# they are never written to logs, databases or reports.
# The default mock demo needs NO credentials at all.

# --- OpenAI-compatible targets -------------------------------------------
# Used when a target sets `api_key_env: OPENAI_API_KEY`.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic target -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Local Ollama target --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11343

# --- LRTK runtime settings ------------------------------------------------
LRTK_OUTPUT_DIR=./runs
LRTK_LOG_LEVEL=INFO
LRTK_DEFAULT_TIMEOUT=60.0
